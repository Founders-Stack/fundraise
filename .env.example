# Founder Stack /capital — copy to apps/web/.env.local (Next.js) and export for the MCP server.
# Devnet only. Never commit real keys.

# --- Solana RPC ---
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
RPC_URL=https://api.devnet.solana.com

# --- Database (Prisma, SQLite; path relative to apps/web/prisma/schema.prisma) ---
DATABASE_URL="file:./dev.db"

# --- API auth (issuer/admin principal: Authorization: Bearer <FS_API_TOKEN>) ---
FS_API_TOKEN=change-me-long-random-string
FS_API_URL=http://localhost:3000/api                # used by packages/fstack-mcp

# --- Demo custody (devnet only): keypairs as JSON byte arrays or file paths ---
FS_AUTHORITY_KEYPAIR=keys/fs-authority.json         # Founder Stack authority (allowlist admin, DBC partner)
ISSUER_KEYPAIR=keys/issuer.json                     # issuer wallet (creates pool, pays distributions)

# --- Mints / programs ---
QUOTE_MINT=<mock-usdc-mint-pubkey>                  # SPL mock USDC, 6 dp
FS_ALLOWLIST_PROGRAM_ID=<fs_allowlist-program-id>   # Token-2022 transfer-hook program

# --- Chain implementation: fake (local, no network) | devnet ---
CHAIN_MODE=fake
