# Founder Stack /capital. Local: copy to apps/web/.env.local. Vercel: set each var in
# Project Settings -> Environment Variables (see docs/deploy.md). Never commit real values.

# --- Database ---
# Local dev: SQLite (prisma/schema.prisma), path relative to apps/web/prisma/.
DATABASE_URL="file:./dev.db"
# Vercel: Postgres pooled URL, used by prisma/postgres/schema.prisma, e.g.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# --- Chain implementation: fake (in-process, no network) | devnet ---
CHAIN_MODE=fake

# --- Solana RPC ---
RPC_URL=https://api.devnet.solana.com                # server-side RPC (use a paid RPC in production)
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com    # browser RPC (wallet pages); exposed to clients

# --- Public URL of the web app (used in /sign and /onboard links returned by the API) ---
PUBLIC_APP_URL=http://localhost:3000

# --- API auth (issuer/admin principal: Authorization: Bearer <FS_API_TOKEN>) ---
FS_API_TOKEN=change-me-long-random-string

# --- Signing (SPEC 0.4): custody = server signs (default, closed pilot);
#     wallet = issuance create / distribution execute return a /sign/[requestId] link the founder signs.
#     A request body's `signingMode` overrides this per call. ---
FS_SIGNING_MODE=custody

# --- Demo custody (devnet, CHAIN_MODE=devnet). Each value is ONE of:
#   a JSON byte array  [12,34,...]   (recommended on Vercel)
#   a base58 secret key
#   a file path         keys/x.json   (local dev only; Vercel has no keys/ dir)
FS_AUTHORITY_KEYPAIR=keys/fs-authority.json          # Founder Stack authority (allowlist admin, DBC partner)
ISSUER_KEYPAIR=keys/issuer.json                      # issuer wallet (creates pool, pays distributions)

# --- Mints / programs (CHAIN_MODE=devnet) ---
QUOTE_MINT=<mock-usdc-mint-pubkey>                   # SPL USDC-like quote mint, 6 dp
FS_ALLOWLIST_PROGRAM_ID=<fs_allowlist-program-id>    # Token-2022 transfer-hook program

# --- Dev only: an in-browser burner wallet in the wallet picker, to click through onboarding and
# trading without Phantom. Never set this for a deployment.
NEXT_PUBLIC_DEV_BURNER_WALLET=

# --- MCP server (packages/fstack-mcp, runs on the agent's machine, not on Vercel) ---
FS_API_URL=http://localhost:3000/api
# FS_API_TOKEN (same value as above)
