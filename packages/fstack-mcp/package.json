{
  "name": "fstack-mcp",
  "version": "0.1.1",
  "description": "Founder Stack MCP server: thin typed tools over the /capital API",
  "type": "module",
  "bin": {
    "fstack-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": ["mcp", "model-context-protocol", "solana", "founder-stack"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Founders-Stack/fundraise.git",
    "directory": "packages/fstack-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "build": "tsc -p tsconfig.json && chmod +x dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "pnpm build && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^5.9.3"
  }
}
