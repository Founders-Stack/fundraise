// SPEC section 3 data model. SQLite for the hackathon (Postgres if deployed).
// SQLite has no enums/Json: enums are String (values documented inline),
// JSON-ish fields (dbcConfig, monetization) are String holding JSON.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Issuance {
  id                    String   @id @default(cuid())
  issuerName            String
  rightsType            String   @default("CASH_FLOW") // CASH_FLOW | VENTURE_EXIT (future)
  poolPercentageBps     Int      // basis points of DCF, e.g. 1000 = 10%
  tokenSupply           BigInt   // whole tokens, e.g. 1_000_000
  symbol                String
  name                  String
  distributionFrequency String   @default("QUARTERLY") // QUARTERLY | MONTHLY
  nextRecordDate        DateTime?

  // curve inputs (SPEC section 5)
  expectedAnnualDcf     BigInt   // USDC base units (6 dp)
  targetInitialYieldBps Int
  graduationMultiple    Float    @default(3)

  agreementVersion      String
  agreementHash         String
  agreementText         String

  // derived, stored
  startingMarketCap     BigInt   // USDC base units
  graduationMarketCap   BigInt   // USDC base units

  quoteMint             String?
  baseMint              String?
  dbcConfig             String?  // JSON: DBC config pubkey + params
  dbcPool               String?
  dammPool              String?
  monetization          String   // JSON: MonetizationConfig

  createdAt             DateTime @default(now())

  participants  Participant[]
  distributions Distribution[]
}

model Participant {
  id                  String    @id @default(cuid())
  issuanceId          String
  issuance            Issuance  @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  wallet              String
  displayName         String?
  verifiedAt          DateTime?
  eligibleAt          DateTime?
  agreementAcceptedAt DateTime?
  agreementSig        String?
  allowlistTx         String?
  createdAt           DateTime  @default(now())

  allocations Allocation[]

  @@unique([issuanceId, wallet])
}

model Distribution {
  id             String    @id @default(cuid())
  issuanceId     String
  issuance       Issuance  @relation(fields: [issuanceId], references: [id], onDelete: Cascade)
  periodLabel    String    // e.g. 2026-Q3
  dcf            BigInt    // issuer-reported distributable cash flow, USDC base units
  reportUrl      String?
  reportHash     String    // sha256 of report JSON
  poolPercentageBps Int
  rightsPool     BigInt    // USDC base units (6 dp)
  perTokenBaseUnits BigInt // USDC base units per whole token
  snapshotJson   String?   // immutable snapshot (holders incl. POOL/UNREGISTERED) as JSON
  status         String    @default("DRAFT") // DRAFT | SNAPSHOTTED | EXECUTED
  snapshotSlot   BigInt?
  totalAllocated BigInt?   // USDC base units
  unallocated    BigInt?   // USDC base units
  executedAt     DateTime?
  createdAt      DateTime  @default(now())

  allocations Allocation[]

  @@unique([issuanceId, periodLabel])
}

model Allocation {
  id             String       @id @default(cuid())
  distributionId String
  distribution   Distribution @relation(fields: [distributionId], references: [id], onDelete: Cascade)
  wallet         String
  participantId  String?
  participant    Participant? @relation(fields: [participantId], references: [id])
  tokens         BigInt       // token base units
  payout         BigInt       // USDC base units
  txSignature    String?

  @@unique([distributionId, wallet])
}

// Preview-before-create gate (SPEC 0.3): POST /api/issuances requires an unused previewId.
model IssuancePreview {
  id         String    @id @default(cuid())
  termsJson  String    // CashFlowTerms + graduationMultiple + monetization, as JSON (bigint as string)
  derivedJson String   // LaunchPricing + fee params + economics, as JSON
  usedAt     DateTime?
  issuanceId String?
  createdAt  DateTime  @default(now())
}
